# ==============================================================================
# RECOrion (Operational Reasoning & Intelligence Orchestration Network)
# Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# GENEL SİSTEM AYARLARI
# ------------------------------------------------------------------------------
PROJECT_NAME=RECOrion
ENVIRONMENT=local_dev
DEBUG=True
SECRET_KEY=BURAYA_UZUN_RASTGELE_BIR_ANAHTAR_YAZIN

# ------------------------------------------------------------------------------
# DOCKER AĞ YAPILANDIRMASI
# ------------------------------------------------------------------------------
DOCKER_NETWORK_NAME=recorion_net

# ------------------------------------------------------------------------------
# POSTGRESQL 16 (pgvector DESTEKLİ DARK DB)
# ------------------------------------------------------------------------------
POSTGRES_USER=recorion_admin
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
POSTGRES_DB=recorion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://recorion_admin:BURAYA_GUCLU_BIR_SIFRE_YAZIN@postgres:5432/recorion_db

# ------------------------------------------------------------------------------
# QDRANT VEKTÖR VERİTABANI (2 KADEMELİ KOLEKTİF HAFIZA)
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=recorion_collective_memory

# ------------------------------------------------------------------------------
# REDIS 7 (STREAMS, CANLI DÜŞÜNCE AKIŞI, WEBSOCKET)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# MINIO (S3 UYUMLU NESNE VE ARTIFACT DEPOSU)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=recorion-artifacts
MINIO_USE_SSL=False

# ------------------------------------------------------------------------------
# GITEA (YEREL KAPALI DEVRE GIT SUNUCUSU)
# ------------------------------------------------------------------------------
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
# Proje kod depoları (ADIM 8.5): yönetici hesabının API anahtarı. Üretmek için:
# docker exec -u git recorion_gitea gitea admin user generate-access-token --username <GITEA_ADMIN_USER> --token-name recorion-backend --scopes all --raw
GITEA_TOKEN=
# GITEA_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# TEMPORAL SERVER (DAYANIKLI İŞ AKIŞI VE SAGA MOTORU)
# ------------------------------------------------------------------------------
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# ------------------------------------------------------------------------------
# EVREN API / LLM GATEWAY (TÜBİTAK BİLGEM & SSB SAYZEK EVREN)
# ------------------------------------------------------------------------------
EVREN_API_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=evren_llm_your_api_key_here
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# ODOO 19 ERP ENTEGRASYONU (DİNAMİK BAĞLANTI PARAMETRELERİ)
# ------------------------------------------------------------------------------
ODOO_URL=https://recdx.odoo.com
ODOO_DB=recdx
ODOO_USER=your_odoo_user@recdx.com
ODOO_PASSWORD=your_odoo_api_key_or_password

# ------------------------------------------------------------------------------
# İLK KURULUM (yalnızca boş veritabanında süper adminleri oluşturmak için)
# ------------------------------------------------------------------------------
RECORION_SUPERADMIN_EMAILS=cuneyterdil@recdx.com,rehaerdag@recdx.com
RECORION_SUPERADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# KİMLİK DOĞRULAMA VE GÜVENLİK
# ------------------------------------------------------------------------------
# SECRET_KEY en az 32 karakter olmalı. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_HOURS=12
REMEMBER_ME_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQL sorgularını parametreleriyle loglar; yalnızca yerel hata ayıklamada açın
DB_ECHO=false

# ------------------------------------------------------------------------------
# MÜŞTERİ YAŞAM DÖNGÜSÜ (Adım 3)
# ------------------------------------------------------------------------------
# E-postalardaki bağlantıların kök adresi (canlıda https://... olmalı)
PUBLIC_APP_URL=http://localhost:5173
ADMIN_NOTIFICATION_EMAIL=info@recdx.com
# smtp: gerçek gönderim · log: göndermeden bellekte tut (geliştirme)
EMAIL_DELIVERY=smtp
ODOO_SYNC_ENABLED=true
ODOO_PRICELIST_ID=1
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
PURCHASE_IP_LIMIT_PER_HOUR=5
EMAIL_CODE_IP_LIMIT_PER_HOUR=20

# TELEGRAM BİLDİRİMLERİ (ADIM 6.5): BotFather'dan bot oluşturup token'ı ve bot kullanıcı adını yazın
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
